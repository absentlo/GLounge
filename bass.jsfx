desc:GLounge Bass
options:no_meter
in_pin:none
out_pin:Left
out_pin:Right

slider1:pluck=0.5<0,1,0.001>-Pluck
slider2:pick=0.25<0,1,0.001>-Pick
slider3:decay=4<0.3,12,0.01:log>-Decay
slider4:tone=2000<200,8000,1:log>-Tone
slider5:drive=0.15<0,1,0.001>-Drive
slider6:out_db=0<-36,6,0.1>-Level

import glounge.jsfx-inc

@init
// two strings, so a new note can start while the last one is damped, without a click
strings_setup(2, 3500, 0.6);
pu_pos = 0.21;
cur = voices;

function note_on(n, vel)
(
  damp(cur);
  cur = cur == voices ? voices + VS : voices;
  start_string(cur, n, vel);
);

ui_setup();
head("STRING");
knob(1, "Pluck", "%.2f", 0, 1, 0.5, 0);
knob(2, "Pick", "%.2f", 0, 1, 0.25, 0);
knob(3, "Decay", "%.1f s", 0.3, 12, 4, 1);
head("AMP");
knob(4, "Tone", "%.0f Hz", 200, 8000, 2000, 1);
knob(5, "Drive", "%.2f", 0, 1, 0.15, 0);
head("OUT");
knob(6, "Level", "%.1f dB", -36, 6, 0, 0);

@block
amp_block(30);
tune_all();
sidx = 0;
pend = midirecv(mofs, m1, m2, m3);

@sample
// MIDI, sample-accurate
while (pend && mofs <= sidx) (
  mst = m1 & 0xF0;
  mst == 0x90 && m3 > 0 ? note_on(m2, m3) :
  // shortcut: one note at a time with no memory of held notes, so a released note does not bring back an older one; keep a note stack if legato playing needs it
  mst == 0x80 || mst == 0x90 ? ( cur[V_NOTE] == m2 ? damp(cur); ) :
  mst == 0xB0 && (m2 == 123 || m2 == 120) ? damp_all() :
  mst == 0xE0 ? ( pb = (m3 * 128 + m2 - 8192) / 4096; ); // +/- 2 semitones, retuned at the next block
  pend = midirecv(mofs, m1, m2, m3);
);
sidx += 1;

spl0 = spl1 = amp(strings_tick());

@gfx 384 125
ui_draw("GLounge Bass", 32) ? (
  // a small bass: two-part body, long neck, then headstock
  c_ink();
  gfx_circle(9, 19, 5, 1, 1);
  gfx_circle(13, 15, 4, 1, 1);
  pointer(13, 15, 0.785, 0, 13);
  pointer(23, 5, 0.785, 0, 4);
  pointer(24, 6, 0.785, 0, 3);
  c_card();
  pointer(8, 20, 0.785, 0, 4); // pickup, so the body does not read as a blob
);
