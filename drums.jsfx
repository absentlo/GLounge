desc:GLounge Drums
options:no_meter
in_pin:none
out_pin:Left
out_pin:Right

slider1:k_tune=62<40,100,0.1:log>-Kick Tune
slider2:k_dec=300<80,1000,1:log>-Kick Decay
slider3:s_tune=190<120,320,0.1:log>-Snare Tune
slider4:snap=0.6<0,1,0.001>-Snare Snap
slider5:h_tone=7000<3000,12000,1:log>-Hat Tone
slider6:h_dec=450<100,1500,1:log>-Open Hat Decay
slider7:t_tune=100<60,160,0.1:log>-Tom Tune
slider8:t_dec=400<100,1000,1:log>-Tom Decay
slider9:drive=0<0,1,0.001>-Crunch
slider10:out_db=0<-36,6,0.1>-Level
slider11:room=0.3<0,1,0.001>-Room

import glounge.jsfx-inc

@init
// ---- struck skins: each drum is a few resonators, the pitches a round skin rings at
modal_setup(6, 6, 0.42);
kick = skins; snare = skins + DS; tom_lo = skins + 2 * DS; tom_mid = skins + 3 * DS; tom_hi = skins + 4 * DS; bell = skins + 5 * DS;
kick[D_PAN] = 0; snare[D_PAN] = 0; tom_lo[D_PAN] = -0.35; tom_mid[D_PAN] = -0.1; tom_hi[D_PAN] = 0.2; bell[D_PAN] = 0.4;

// ---- metal: noise through resonances at unrelated pitches, so it never settles into a note
BANDS = 6;
B_A1 = 0; B_A2 = 1; B_G = 2; B_Y1 = 3; B_Y2 = 4;
BS = 5;
hat_bank = alloc(BANDS * BS);
cym_bank = alloc(BANDS * BS);
memset(hat_bank, 0, BANDS * BS);
memset(cym_bank, 0, BANDS * BS);

function band(b, hz) local(w, r)
(
  hz = min(hz, srate * 0.45);
  w = TWO_PI * hz / srate;
  r = exp(-$pi * hz * 0.12 / srate);
  b[B_A1] = 2 * r * cos(w); b[B_A2] = -r * r; b[B_G] = 1 - r;
);

function bank_set(bank, hz)
(
  band(bank, hz * 0.45); band(bank + BS, hz * 0.62); band(bank + 2 * BS, hz * 0.81);
  band(bank + 3 * BS, hz); band(bank + 4 * BS, hz * 1.27); band(bank + 5 * BS, hz * 1.55);
);
bank_set(cym_bank, 6000);

function bank_tick(bank, x) local(b, y, s)
(
  b = bank; s = 0;
  loop(BANDS,
    y = b[B_A1] * b[B_Y1] + b[B_A2] * b[B_Y2] + b[B_G] * x;
    b[B_Y2] = b[B_Y1]; b[B_Y1] = y;
    s += y;
    b += BS;
  );
  s;
);

hat_fall = 0; cym_fall = 0; hat_tick_e = 0;
closed_fall = fall(0.07);
crash_fall = fall(2.6);
ride_fall = fall(1.1);
tick_fall = fall(0.004);
sn_k = 1 - exp(-TWO_PI * 1800 / srate);
sw_k = 1 - exp(-TWO_PI * 7500 / srate);
clap_fall = fall(0.03);
clap_tail = fall(0.18);
cl_k = 2 * sin($pi * 1100 / srate); // a clap is noise through a narrow band

room_setup();

// no two hits are identical, or fast playing turns into a machine gun
function vary(x) ( x * (1 + (rand(2) - 1) * 0.004); );

function hit(n, vel) local(a, f, d, c, b, k)
(
  a = (0.25 + 0.75 * vel * vel) * (0.97 + rand(0.06)); // harder hits are much louder, like a real drum
  c = 4 - 3 * vel; // and shorter on the skin
  b = 0.3 + 0.7 * vel; // and they wake the skin's higher pitches
  k = vel * vel; // and the stick's noise, so soft hits are darker as well as quieter
  n == 35 || n == 36 ? (
    f = vary(k_tune); d = k_dec * 0.001;
    mode(kick, 0, f, 1.3, d);
    mode(kick, 1, f * 1.59, 0.45, d * 0.4);
    mode(kick, 2, f * 2.14, 0.26 * b, d * 0.3);
    mode(kick, 3, f * 2.92, 0.16 * b, d * 0.2);
    mode(kick, 4, 420, 0.28 * b, 0.05); // the shell
    strike(kick, 5, c + 1, a, 0.3 * k, d, 0.1, 0.05);
  ) : n == 38 || n == 40 ? (
    f = vary(s_tune);
    mode(snare, 0, f, 0.8, 0.2);
    mode(snare, 1, f * 1.59, 0.5, 0.14);
    mode(snare, 2, f * 2.14, 0.35 * b, 0.11);
    mode(snare, 3, f * 2.30, 0.3 * b, 0.1);
    mode(snare, 4, f * 2.65, 0.2 * b, 0.08);
    mode(snare, 5, f * 2.92, 0.15 * b, 0.07);
    strike(snare, 6, c * 0.5, a * 0.75 * (1 - 0.4 * snap), 0.3 * k, 0.25, 0.02, 0.03);
    sn_e = a * b; // the wires, shaken harder by a harder hit
  ) : n == 39 ? (
    clap_e = a; clap_a = a; clap_t = 0;
  ) : n == 42 || n == 44 ? (
    // the same channel as the open hat, so closing the hat cuts it, like the real pedal
    hat_e = a; hat_fall = closed_fall; hat_tick_e = a;
  ) : n == 46 ? (
    hat_e = a; hat_fall = open_fall; hat_tick_e = a;
  ) : n == 49 || n == 52 || n == 55 || n == 57 ? (
    cym_e = a; cym_fall = crash_fall; cym_pan = -0.4;
  ) : n == 51 || n == 53 || n == 59 ? (
    cym_e = a * 0.7; cym_fall = ride_fall; cym_pan = 0.4;
    mode(bell, 0, vary(2850), 0.2, 0.7); // the ride's ping
    mode(bell, 1, vary(4230), 0.12, 0.45);
    mode(bell, 2, vary(6190), 0.08, 0.3);
    strike(bell, 3, 0.5, a, 0.05, 0.7, 0, 1);
  ) : n == 41 || n == 43 || n == 45 || n == 47 || n == 48 || n == 50 ? (
    d = n <= 45 ? tom_lo : n <= 48 ? tom_mid : tom_hi;
    f = vary(t_tune) * 2 ^ ((n - 45) * 1.6 / 12); // wider apart than the notes, as a kit's toms are tuned
    c = t_dec * 0.001;
    mode(d, 0, f, 1, c);
    mode(d, 1, f * 1.59, 0.4, c * 0.6);
    mode(d, 2, f * 2.14, 0.25 * b, c * 0.4);
    mode(d, 3, f * 2.30, 0.15 * b, c * 0.3);
    strike(d, 4, 4 - 3 * vel, a, 0.2 * k, c, 0.1, 0.08);
  );
);

ui_setup();
head("KICK");
knob(1, "Tune", "%.0f Hz", 40, 100, 62, 1);
knob(2, "Decay", "%.0f ms", 80, 1000, 300, 1);
head("SNARE");
knob(3, "Tune", "%.0f Hz", 120, 320, 190, 1);
knob(4, "Snap", "%.2f", 0, 1, 0.6, 0);
head("HATS");
knob(5, "Tone", "%.0f Hz", 3000, 12000, 7000, 1);
knob(6, "Open", "%.0f ms", 100, 1500, 450, 1);
head("TOMS");
knob(7, "Tune", "%.0f Hz", 60, 160, 100, 1);
knob(8, "Decay", "%.0f ms", 100, 1000, 400, 1);
head("KIT");
knob(11, "Room", "%.2f", 0, 1, 0.3, 0);
knob(9, "Crunch", "%.2f", 0, 1, 0, 0);
head("OUT");
knob(10, "Level", "%.1f dB", -36, 6, 0, 0);

@block
drv_g = 1 + drive * drive * 20;
drv_out = (1 + drive * 0.5) / (1 + drive);
out_g = 0.75 * 10 ^ (out_db / 20); // leaves room for several pieces landing together
sn_fall = fall(0.08 + 0.2 * snap);
open_fall = fall(h_dec * 0.001);
h_tone != h_last ? ( bank_set(hat_bank, h_tone); h_last = h_tone; );
room_block();
sidx = 0;
pend = midirecv(mofs, m1, m2, m3);

@sample
// MIDI, sample-accurate. Drums ring out on their own, so note-offs are ignored.
while (pend && mofs <= sidx) (
  (m1 & 0xF0) == 0x90 && m3 > 0 ? hit(m2, m3 / 127);
  pend = midirecv(mofs, m1, m2, m3);
);
sidx += 1;

out_l = out_r = 0;

modal_tick();

sn_e > 0.0005 ? (
  x = rand(2) - 1;
  sn_lo += sn_k * (x - sn_lo);
  sn_hi += sw_k * (x - sn_lo - sn_hi);
  o = sn_hi * sn_e * (0.2 + 0.9 * snap);
  out_l += o; out_r += o;
  sn_e *= sn_fall;
);

clap_e > 0.0005 ? (
  // a few quick bursts, then a tail: several hands that never land together
  clap_t += 1;
  clap_t == floor(0.011 * srate) || clap_t == floor(0.022 * srate) || clap_t == floor(0.033 * srate) ? clap_e = clap_a;
  x = rand(2) - 1;
  cl_h = x - cl_l - 0.4 * cl_b;
  cl_b += cl_k * cl_h;
  cl_l += cl_k * cl_b;
  o = cl_b * clap_e * 0.7;
  out_l += o; out_r += o;
  clap_e *= clap_t > 0.033 * srate ? clap_tail : clap_fall;
);

hat_e > 0.0005 ? (
  x = rand(2) - 1;
  // the stick's tick on top of the metal's hiss
  o = (bank_tick(hat_bank, x) * 0.4 + x * hat_tick_e * 0.25) * hat_e;
  out_l += o * 0.7; out_r += o * 1.3;
  hat_e *= hat_fall; hat_tick_e *= tick_fall;
);

cym_e > 0.0005 ? (
  x = rand(2) - 1;
  o = bank_tick(cym_bank, x) * 0.35 * cym_e;
  out_l += o * (1 - cym_pan); out_r += o * (1 + cym_pan);
  cym_e *= cym_fall;
);

room_tick();

drive > 0 ? (
  x = out_l * drv_g; out_l = x / (1 + abs(x)) * drv_out;
  x = out_r * drv_g; out_r = x / (1 + abs(x)) * drv_out;
);

// hard ceiling: the last line of defence for speakers and ears
spl0 = max(-1, min(1, out_l * out_g));
spl1 = max(-1, min(1, out_r * out_g));

@gfx 704 125
ui_draw("GLounge Drums", 32) ? (
  // a small snare and two crossed sticks
  c_ink();
  gfx_rect(7, 15, 16, 8);
  c_paper();
  gfx_rect(7, 17, 16, 1);
  c_ink();
  pointer(10, 14, 0.7, 0, 15);
  pointer(20, 14, -0.7, 0, 15);
);
